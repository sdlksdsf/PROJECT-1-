# ---- Server-only secrets ----
# Put real values in Vercel (Project > Settings > Environment Variables) or in a local .env.
# Never commit real values. Every key is read on the server only; none reach the browser bundle.
# Each feature is optional: without its key the site shows a clear "not connected" note.

# Supabase project URL and SERVICE ROLE key. Enables the news archive (/api/archive)
# and the editable outlet registry (/api/sources).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Windy Webcams API v3 key (free, api.windy.com > API keys). Header X-WINDY-API-KEY. Live public cameras per country.
WINDY_API_KEY=

# OpenWebcamDB API key (free account, openwebcamdb.com > API keys). Bearer token. Second source of public cameras.
WEBCAMDB_API_KEY=

# AISStream.io key (free, aisstream.io). Enables live ship positions via /api/ships.
AISSTREAM_API_KEY=

# US EIA Open Data key (free, eia.gov/opendata/register.php). Enables proved crude-oil reserves per country.
EIA_API_KEY=

# OpenSky Network API client (free account, opensky-network.org > Account > API client).
# Registered clients get a larger daily credit budget than anonymous use.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# OpenWeather API key (free, openweathermap.org > API keys). Current conditions on the weather panel.
OPENWEATHER_API_KEY=

# AviationStack API key (free, aviationstack.com). Flight status lookup in the traffic panel.
AVIATIONSTACK_API_KEY=
