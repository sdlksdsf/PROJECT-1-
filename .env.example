# ---- Server-only secrets (set these in the Vercel project settings; never commit real values) ----

# Supabase project URL and SERVICE ROLE key. Enables the news archive (/api/archive)
# and the editable outlet registry (/api/sources). Without them the site still works.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Windy Webcams API v3 key (free, api.windy.com > API keys, header X-WINDY-API-KEY). Enables live public cameras per country.
WINDY_API_KEY=

# AISStream.io key (free, aisstream.io). Enables live ship positions via /api/ships.
AISSTREAM_API_KEY=

# US EIA Open Data key (free, eia.gov/opendata/register.php). Enables proved crude-oil reserves per country.
EIA_API_KEY=

# OpenSky Network API client (free account, opensky-network.org > Account > API client).
# Registered clients get a larger daily credit budget than anonymous use (400 credits/day).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
