# ---- Server (Vercel project environment variables; never expose these in the browser) ----
# Supabase project URL and SERVICE ROLE key. Enables the news archive (/api/archive)
# and the editable outlet registry (/api/sources). Without them the site still works.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Windy Webcams API v3 key (free registration). Enables live public cameras per country.
WINDY_API_KEY=

# ---- Browser (embedded in the client bundle; keep these public-safe) ----
# AISStream.io key (free). Enables the live ship layer. It is visible to browsers by design.
VITE_AISSTREAM_API_KEY=
