{
  "name": "unbiased-stats",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "UNBIASED STATS - a live, source-transparent 3D globe of world news, conflicts, disasters, flights, markets, weather and country statistics.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
